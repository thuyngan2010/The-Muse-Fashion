# syntax=docker/dockerfile:1.7
FROM node:24-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json .npmrc ./
COPY apps/web/package.json apps/web/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --fetch-timeout=60000 --fetch-retries=2

COPY apps/web apps/web
COPY packages/contracts packages/contracts
COPY scripts/write-web-runtime-config.mjs scripts/write-web-runtime-config.mjs
RUN npm run build:web:prod

FROM nginx:1.27-alpine AS runtime
ENV API_UPSTREAM=http://127.0.0.1:3000 \
    NGINX_ENVSUBST_FILTER=^(API_UPSTREAM)$
COPY deploy/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/nginx/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY deploy/nginx/40-runtime-config.sh /docker-entrypoint.d/40-runtime-config.sh
COPY --from=build /app/apps/web/dist/browser /usr/share/nginx/html
RUN chmod +x /docker-entrypoint.d/40-runtime-config.sh
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD wget -qO- http://127.0.0.1:8080/healthz >/dev/null || exit 1
