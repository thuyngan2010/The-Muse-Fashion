# Copy to deploy/.env for `docker compose --env-file deploy/.env -f compose.deploy.yaml ...`.
# Compose interpolation only; API secrets belong in API_ENV_FILE, not here.

# Container images may point to GHCR, Docker Hub, or a private registry.
API_IMAGE=fashion-commerce-api:local
WEB_IMAGE=fashion-commerce-web:local

# Secret-bearing API environment file stays on the target server.
API_ENV_FILE=apps/api/.env

# Bind to 127.0.0.1 behind a host reverse proxy; use 0.0.0.0 only when intentional.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# Same-origin through the web container is portable and avoids CORS.
# For compose.web.yaml on a separate server, set https://api.example.com/api/v1.
PUBLIC_API_BASE_URL=/api/v1

# Standalone backend (compose.api.yaml), behind the backend host's TLS reverse proxy.
API_BIND_ADDRESS=127.0.0.1
API_PORT=3000

# API docs override for the production container (true/false).
SWAGGER_ENABLED=false

# The combined compose.deploy.yaml also sets API_UPSTREAM=http://api:3000.
# Standalone compose.web.yaml calls PUBLIC_API_BASE_URL directly from the browser.
