{
  "name": "fashion-commerce-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "dev:api": "npm run start:dev --workspace @fashion/api",
    "dev:web": "npm run start --workspace @fashion/web",
    "dev:ai-mock": "npm run ai:mock --workspace @fashion/api",
    "build:contracts": "npm run build --workspace @fashion/contracts",
    "build:api": "npm run build:contracts && npm run build --workspace @fashion/api",
    "build:web": "npm run build:contracts && npm run build --workspace @fashion/web",
    "build:web:prod": "npm run build:contracts && npm run build --workspace @fashion/web -- --configuration production",
    "build:web:vercel": "node scripts/write-web-runtime-config.mjs --require && npm run build:web:prod",
    "build": "npm run build:contracts && npm run build --workspace @fashion/api && npm run build --workspace @fashion/web -- --configuration production",
    "test": "npm run test --workspace @fashion/api",
    "test:web:config": "node --test scripts/write-web-runtime-config.test.mjs",
    "test:integration": "npm run test:integration --workspace @fashion/api",
    "check:docs": "node scripts/check-docs.mjs",
    "check:env": "node scripts/check-env-examples.mjs",
    "check:scripts": "node scripts/check-api-script-targets.mjs",
    "seed": "npm run seed --workspace @fashion/api",
    "check:routes": "node scripts/check-openapi-routes.mjs",
    "test:audit": "vitest run --config vitest.audit.config.mts"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  },
  "packageManager": "npm@10.9.2",
  "overrides": {
    "multer": "^2.5.0",
    "vite": "^8.3.5"
  }
}
