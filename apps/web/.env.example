# Copy to apps/web/.env. Loaded by npm run dev:web, build:web and build:web:prod.
# Host/build environment variables override this file. Restart/rebuild after changes.
# Default: same-origin /api proxy. For a separate backend server, use its public URL:
# PUBLIC_API_BASE_URL=https://api.example.com/api/v1
# HTTP URLs (including remote IPs) are supported for development; use HTTPS in production.
# Docker reads PUBLIC_API_BASE_URL at container startup (deploy/.env for Compose).
PUBLIC_API_BASE_URL=/api/v1
