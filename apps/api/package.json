{
  "name": "@fashion/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:dev": "npm run build && node --watch --env-file=.env dist/main.js",
    "build:watch": "tsc -p tsconfig.build.json -w",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "ai:mock": "node --import=tsx src/scripts/ai-mock-provider.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "seed": "node --env-file=.env --import=tsx src/scripts/seed.ts",
    "admin:grant": "node --env-file=.env --import=tsx src/scripts/bootstrap-admin.ts",
    "migrate": "node --env-file-if-exists=.env dist/scripts/migrate.js",
    "e2e:ensure-admin": "node --env-file=.env --import=tsx src/scripts/ensure-e2e-admin.ts",
    "e2e:live": "node --env-file=.env --import=tsx src/scripts/live-e2e.ts",
    "email:flush": "node --env-file=.env --import=tsx src/scripts/flush-emails.ts",
    "test:performance": "vitest run --config vitest.performance.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@fashion/contracts": "1.0.0",
    "@gpmpay/sdk": "^0.4.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@sendgrid/mail": "^8.1.5",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "mongoose": "^9.0.0",
    "openai": "^7.43.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  }
}
