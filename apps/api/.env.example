# Copy to apps/api/.env for local development. Set secrets independently per environment.
# The API reads this file through ConfigModule in dev; Docker Compose uses API_ENV_FILE.

# API runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/fashion_commerce?replicaSet=rs0
# Tùy chọn: DNS dùng để tra địa chỉ MongoDB. Đặt khi dùng mongodb+srv:// (Atlas) mà gặp lỗi querySrv ECONNREFUSED.
# Ví dụ: MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
MONGODB_DNS_SERVERS=
JWT_SECRET=replace-with-at-least-32-random-characters-for-development
# 32 random bytes encoded as 64 hexadecimal characters. Keep stable across deployments.
REFUND_ENCRYPTION_KEY=
EMAIL_TOKEN_ENCRYPTION_KEY=
API_CORS_ORIGIN=http://localhost:4200
# Required true when the browser calls the API from a different origin.
API_CORS_CREDENTIALS=false
TRUST_PROXY=false
SWAGGER_ENABLED=true
# Set true behind HTTPS in production; auth-cookie.util also defaults to true for NODE_ENV=production.
REFRESH_COOKIE_SECURE=false
# Keep lax for same-site hosts (shop.example.com + api.example.com).
# Different sites require none + REFRESH_COOKIE_SECURE=true over HTTPS.
REFRESH_COOKIE_SAME_SITE=lax

# Public URL used in verification email links (no trailing slash).
PUBLIC_WEB_URL=http://localhost:4200

# SendGrid. Required only when sending email; sender must be verified.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Fashion Commerce

# Cloudflare R2. Required only for uploads. PUBLIC_BASE_URL is reserved for read URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=
R2_UPLOAD_MAX_BYTES=5242880

# AI Virtual Try-on / Mix & Match (requires AI_ENABLED=true and provider config).
# Provider contract is selected automatically; schema rejection permits a one-time fallback.
# Keep the API key server-side; do not put it in apps/web/.env.
AI_ENABLED=false
AI_API_BASE_URL=
AI_API_KEY=
AI_TRY_ON_MODEL=
AI_MIX_MATCH_MODEL=
AI_REQUEST_TIMEOUT_MS=120000

# Optional vision/planning model, independent of the image-rendering provider above.
AI_PLANNER_ENABLED=false
AI_PLANNER_BASE_URL=http://localhost:20128/v1
AI_PLANNER_API_KEY=
AI_PLANNER_MODEL=ag/gemini-3.8-flash-medium
AI_PLANNER_TIMEOUT_MS=90000

# Select one active payment provider for this API deployment (GPMPAY or SEPAY).
PAYMENT_PROVIDER=GPMPAY

# GPM Pay payment integration; required only when PAYMENT_PROVIDER=GPMPAY.
GPMPAY_WEBHOOK_SECRET=
GPMPAY_BANK_BIN=
GPMPAY_ACCOUNT_NUMBER=
GPMPAY_ACCOUNT_NAME=

# SePay webhook API Key authentication and merchant receiving account; required only when PAYMENT_PROVIDER=SEPAY.
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_BIN=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=

# One-time bootstrap-admin script only. Leave ADMIN_CONFIRM blank until intentionally running it.
ADMIN_EMAIL=
ADMIN_CONFIRM=

# Optional local live E2E helper scripts.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_ADMIN_NAME=
E2E_ADMIN_RESET_PASSWORD=
API_BASE_URL=
PAYMENT_TEST_EMAIL=
PAYMENT_TEST_PASSWORD=
PAYMENT_TUNNEL_URL=
PAYMENT_SIMULATE_WEBHOOK=YES
PAYMENT_WAIT_GPM=NO
AI_E2E_WAIT_MS=60000
AI_E2E_TRYON_RETRY=1
AI_MOCK_PORT=3669
AI_MOCK_MODE=success
AI_MOCK_API_KEY=local-ai-mock
AI_E2E_ALLOW_MOCK=0

# Đăng nhập bằng Google (tùy chọn). Dùng cùng giá trị với PUBLIC_GOOGLE_CLIENT_ID của web.
# Để trống thì POST /auth/google trả 503 và web ẩn nút Google.
GOOGLE_CLIENT_ID=
